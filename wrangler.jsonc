// Cloudflare deploy settings for the yunaui.com website (only on the "website" branch).
{
  "name": "patient-disk-8c87",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./docs", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "LIKES", "class_name": "Likes" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Likes"] }]
}
